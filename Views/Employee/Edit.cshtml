@using WebApplication4.Models.Entities
@model Employee

<form asp-action="SaveEditData" asp-controller = "Employee">
    <input type = "hidden" asp-for="Id" />
    
    <div class="form-group">
        <label for="name1">Name</label>
        <input asp-for = "Name" type="text" class="form-control" id="name1" aria-describedby="nameHelp" placeholder="Enter name">
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <br />
    
    <div class="form-group">
        <label for="age1"> Age</label>
        <input asp-for = "Age" type="text" class="form-control" id="age1" aria-describedby="ageHelp" placeholder="Enter age">
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>
    
    <br />

    @if (ViewBag.HomeMessage != null)
    {

        <div class="alert alert-danger" role="alert">
			@ViewBag.HomeMessage
        </div>
    }

    <button type="submit" class="btn btn-primary">Submit</button>

</form>

@section Scripts
{
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation/dist/additional-methods.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
